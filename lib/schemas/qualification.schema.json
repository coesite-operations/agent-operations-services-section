{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "union-officer-academy/schema/qualification",
  "title": "Qualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "assessment", "enrollment", "candidate", "baseline", "issuedAt", "issuer", "competencies", "limitations", "conveysAuthority", "customerAdmissionRequired"],
  "properties": {
    "type": {"const": "Qualification"},
    "id": {"$ref": "#/$defs/id"},
    "assessment": {"$ref": "#/$defs/id"},
    "enrollment": {"$ref": "#/$defs/id"},
    "candidate": {"type": "object", "required": ["id", "kind", "identityDigest", "appointmentLayer", "layerBindings"], "additionalProperties": true},
    "baseline": {"$ref": "#/$defs/id"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "issuer": {"type": "string", "minLength": 1},
    "competencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "conveysAuthority": {"const": false},
    "customerAdmissionRequired": {"const": true},
    "supersedes": {"$ref": "#/$defs/id"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"}}
}
