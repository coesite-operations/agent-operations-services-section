{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "union-officer-academy/schema/qualification-status-event",
  "title": "Qualification Status Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "qualification", "event", "recordedAt", "issuer", "reason", "evidence", "conveysAuthority"],
  "properties": {
    "type": {"const": "QualificationStatusEvent"},
    "id": {"$ref": "#/$defs/id"},
    "qualification": {"$ref": "#/$defs/id"},
    "event": {"enum": ["correction", "suspension", "revocation", "expiry", "reinstatement", "supersession"]},
    "recordedAt": {"type": "string", "format": "date-time"},
    "issuer": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
    "conveysAuthority": {"const": false},
    "successorQualification": {"$ref": "#/$defs/id"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}

