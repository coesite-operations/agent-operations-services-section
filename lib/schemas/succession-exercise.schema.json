{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "union-officer-academy/schema/succession-exercise",
  "title": "Succession Exercise",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "kind", "enrollment", "baseline", "performedAt", "openObligations", "contradictions", "protectedContextTransfer", "witnesses", "customerMutation", "performsReceiverAct"],
  "properties": {
    "type": {"const": "SuccessionExercise"},
    "id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["incumbent-handover", "office-succession", "curriculum-bridge"]},
    "enrollment": {"$ref": "#/$defs/id"},
    "baseline": {"$ref": "#/$defs/id"},
    "performedAt": {"type": "string", "format": "date-time"},
    "openObligations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contradictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "protectedContextTransfer": {"enum": ["not-required", "simulated", "receiver-controlled"]},
    "witnesses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
    "customerMutation": {"const": false},
    "performsReceiverAct": {"const": false}
  },
  "$defs": {"id": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
