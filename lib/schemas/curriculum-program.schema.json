{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "union-officer-academy/schema/curriculum-program",
  "title": "Curriculum Program",
  "type": "object",
  "required": ["id", "name", "owner", "purpose", "competencies"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "owner": {"const": "union-officer-academy"},
    "purpose": {"type": "string", "minLength": 1},
    "competencies": {"type": "array", "minItems": 1},
    "formationStages": {"type": "array", "minItems": 1},
    "assessment": {"type": "object"},
    "assessmentLaw": {"type": "object"},
    "omissions": {"type": "array"},
    "targetOffice": {"type": "object"},
    "sourceDoctrine": {"type": "array"}
  }
}

