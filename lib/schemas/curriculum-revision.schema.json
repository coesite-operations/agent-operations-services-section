{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "union-officer-academy/schema/curriculum-revision",
  "title": "Curriculum Revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "request", "compiledAt", "stages", "competencyMap", "doctrineSources", "omissions", "parents"],
  "properties": {
    "type": {"const": "CurriculumRevision"},
    "id": {"$ref": "#/$defs/id"},
    "request": {"$ref": "#/$defs/id"},
    "compiledAt": {"type": "string", "format": "date-time"},
    "stages": {"type": "array", "minItems": 1, "items": {"enum": ["orientation", "simulation", "shadow-work", "supervised-practice", "independent-demonstration", "reflection", "teaching-back"]}},
    "competencyMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
    "doctrineSources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["identity", "digest", "owner", "authorityClass", "admissionTerms"], "additionalProperties": false, "properties": {"identity": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "owner": {"type": "string", "minLength": 1}, "authorityClass": {"enum": ["current-law", "current-practice", "admitted-research", "legacy-prior-art", "customer-overlay"]}, "admissionTerms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "omissions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "parents": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "customerOverlayDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
