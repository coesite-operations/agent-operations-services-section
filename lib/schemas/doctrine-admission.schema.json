{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "union-officer-academy/schema/doctrine-admission",
  "title": "Doctrine Admission",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "source", "digest", "owner", "authorityClass", "jurisdiction", "useGrant", "reading", "admittedAt", "reason"],
  "properties": {
    "type": {"const": "DoctrineAdmission"},
    "id": {"$ref": "#/$defs/id"},
    "source": {"type": "string", "minLength": 1},
    "digest": {"$ref": "#/$defs/digest"},
    "owner": {"type": "string", "minLength": 1},
    "authorityClass": {"enum": ["current-law", "current-practice", "admitted-research", "legacy-prior-art", "customer-overlay"]},
    "jurisdiction": {"type": "string", "minLength": 1},
    "useGrant": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reading": {"enum": ["binding-within-source-jurisdiction", "binding-academy-law", "illustrative", "contested", "rejected"]},
    "admittedAt": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "supersedes": {"$ref": "#/$defs/id"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}

