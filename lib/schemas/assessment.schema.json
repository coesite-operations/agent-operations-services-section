{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "union-officer-academy/schema/assessment",
  "title": "Independent Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "enrollment", "baseline", "bundle", "challengeReveal", "assessedAt", "assessor", "examinerIdentity", "trainerIdentities", "independent", "coverage", "witnesses", "disposition"],
  "properties": {
    "type": {"const": "Assessment"},
    "id": {"$ref": "#/$defs/id"},
    "enrollment": {"$ref": "#/$defs/id"},
    "baseline": {"$ref": "#/$defs/id"},
    "bundle": {"$ref": "#/$defs/id"},
    "challengeReveal": {"$ref": "#/$defs/id"},
    "assessedAt": {"type": "string", "format": "date-time"},
    "assessor": {"type": "string", "minLength": 1},
    "examinerIdentity": {"$ref": "#/$defs/actorBinding"},
    "trainerIdentities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "independent": {"const": true},
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["competency", "result"],
        "additionalProperties": false,
        "properties": {
          "competency": {"type": "string", "minLength": 1},
          "result": {"enum": ["no-admitted-evidence", "demonstrated", "refuted", "contradictory"]},
          "witnessDigests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}}
        }
      }
    },
    "witnesses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
    "disposition": {"enum": ["qualified", "gaps"]},
    "controlAssessment": {"$ref": "#/$defs/id"},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "actorBinding": {"type": "object", "required": ["office", "characterDigest", "runtimeSessionDigest", "agentRelationDigest", "providerEngagement"], "properties": {"office": {"type": "string", "minLength": 1}, "characterDigest": {"$ref": "#/$defs/digest"}, "runtimeSessionDigest": {"$ref": "#/$defs/digest"}, "agentRelationDigest": {"$ref": "#/$defs/digest"}, "providerEngagement": {"type": "string", "minLength": 1}}}
  }
}
