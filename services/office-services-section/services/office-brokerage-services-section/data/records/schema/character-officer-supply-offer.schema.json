{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "union-officer-academy/schema/character-officer-supply-offer",
  "type": "object",
  "required": ["type", "provider", "receiver", "office", "character", "cohort", "qualification", "contextBundleDigest", "procurement", "animationPlan", "authorityWithheld"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "type": {"const": "CharacterOfficerSupplyOffer"},
    "provider": {"const": "union-officer-academy"},
    "receiver": {"type": "string"},
    "office": {"type": "object"},
    "character": {"type": "object"},
    "cohort": {"type": "object"},
    "qualification": {"type": "object"},
    "contextBundleDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "procurement": {"type": "object"},
    "animationPlan": {"type": "object"},
    "authorityWithheld": {"type": "array", "minItems": 5, "items": {"type": "string"}}
  }
}
