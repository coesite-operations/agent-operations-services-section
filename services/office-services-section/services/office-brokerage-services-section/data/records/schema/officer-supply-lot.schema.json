{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "union-officer-academy/schema/officer-supply-lot",
  "type": "object",
  "required": ["id", "type", "issuer", "market", "necessity", "office", "outcome", "requiredProducts", "selectionCriteria", "providerNeutral", "selectedProvider", "receiverKeeps"],
  "properties": {
    "id": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"},
    "type": {"const": "OfficerSupplyLot"},
    "issuer": {"type": "string"},
    "market": {"type": "string"},
    "necessity": {"type": "string"},
    "office": {"type": "object"},
    "outcome": {"type": "string"},
    "requiredProducts": {"type": "array", "minItems": 1},
    "selectionCriteria": {"type": "array", "minItems": 1},
    "settlement": {"type": "string"},
    "providerNeutral": {"const": true},
    "selectedProvider": {"type": "null"},
    "receiverKeeps": {"type": "array", "minItems": 5}
  }
}
