{
  "name": "@harmonious-union/scheduled-activity-delivery-service",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Portable ScheduleDelivery service for colony-owned, contracted, idempotent ActivityStreams delivery.",
  "exports": {
    ".": "./src/service.mjs"
  },
  "bin": {
    "solicit-service": "./src/service.mjs",
    "invoke-service": "./src/service.mjs",
    "renew-schedule": "./src/service.mjs",
    "retire-schedule": "./src/service.mjs",
    "run-due": "./src/service.mjs"
  },
  "scripts": {
    "check": "node --check src/service.mjs && node --check test/cold-red-gate-deployment.test.mjs",
    "test": "node --test test/cold-red-gate-deployment.test.mjs",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@red-cup-engineering/ni-uri-services-section": "0.1.1",
    "@red-cup-engineering/semantic-content-identify-service": "0.1.10",
    "@red-cup-engineering/semantic-record-journal-service": "0.1.0"
  }
}
